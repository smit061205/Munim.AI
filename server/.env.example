# MongoDB Connection
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/your_database?retryWrites=true&w=majority

# Authentication
# Signs session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=your_long_random_secret_here
# How long a sign-in lasts
JWT_EXPIRES_IN=7d

# Assistant (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemini-3.1-flash-lite

# Assistant limits, per user
AI_DAILY_MESSAGE_LIMIT=20
AI_PER_MINUTE_LIMIT=5
AI_MONTHLY_TOKEN_LIMIT=1000000
# Most tokens sent to the model for one reply; older messages get summarised
AI_CONTEXT_TOKEN_LIMIT=16000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_MESSAGE_CHARS=4000

# Server Configuration
PORT=5001
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173
